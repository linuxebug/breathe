# Discord Bot Token (from Discord Developer Portal)
TOKEN=your_discord_bot_token_here

# Admin Discord User ID (get from Discord Developer Mode)
ADMIN_ID=paste your discord user id

# Bot Configuration
BOT_STATUS_NAME=Breathe Cloud
WATERMARK=Breathe Cloud Team
DISCORD_SUPPORT_LINK=https://discord.gg/zC3xHcnj8r

# VPS Defaults
DEFAULT_RAM=2g
DEFAULT_CPU=1
DEFAULT_DISK=10G
VPS_HOSTNAME=breathe-vps
SERVER_LIMIT=1
TOTAL_SERVER_LIMIT=50

# Database
DATABASE_FILE=bot.db

# VPS Plans:
# 2GB RAM = 10GB Disk
# 4GB RAM = 25GB Disk
# 8GB RAM = 50GB Disk
# 16GB RAM = 100GB Disk
